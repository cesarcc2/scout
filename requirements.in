# Loose ranges — the source of truth for what Scout actually depends on.
# `requirements.txt` is the pinned lock generated from this; the image installs
# the lock, never this file.
#
#   python3.12 -m venv .venv
#   .venv/bin/pip install -r requirements.in
#   .venv/bin/pip freeze > requirements.txt
#   .venv/bin/python -m pytest tests -q      # <- in the venv, before shipping

