# --- database -------------------------------------------------------------
POSTGRES_PASSWORD=change-me
SCOUT_DSN=postgresql://scout:change-me@db:5432/scout

# --- collector politeness -------------------------------------------------
# Seconds between requests to the same site. Do not go below 2.
SCOUT_REQUEST_DELAY=4.0
SCOUT_MAX_PAGES=8
SCOUT_USER_AGENT_PROFILE=chrome124

# --- scheduling -----------------------------------------------------------
# How often the full collect -> normalize -> price -> alert cycle runs.
SCOUT_CYCLE_MINUTES=45
# Retail baselines are slow-moving; once a day is plenty.
SCOUT_RETAIL_HOUR=7

# --- alerting -------------------------------------------------------------
# ntfy: just set a topic and you get push on phone/desktop for free.
SCOUT_NTFY_URL=https://ntfy.sh
SCOUT_NTFY_TOPIC=
# Telegram alternative (leave blank to disable)
SCOUT_TELEGRAM_TOKEN=
SCOUT_TELEGRAM_CHAT_ID=

# --- deal thresholds ------------------------------------------------------
# A listing must sit at or below this percentile of its product's recent
# market distribution to count as a deal.
SCOUT_DEAL_PERCENTILE=0.20
# ...and there must be at least this many comparable listings to trust it.
SCOUT_MIN_SAMPLES=8

# --- web ------------------------------------------------------------------
SCOUT_HOST=0.0.0.0
SCOUT_PORT=8077
